# Get your API key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Server port (optional, defaults to 3000)
PORT=3000

# Supabase, for Learn mode progress (optional: without these, lessons still work
# but progress isn't saved and the progress routes return 503)
# Project URL: Supabase dashboard -> Project Settings -> Data API
SUPABASE_URL=https://your-project-ref.supabase.co
# SECRET key (sb_secret_... or legacy service_role). Server-only: never put it in
# frontend code or a public/client-side variable. Not the publishable/anon key.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key-here
